{"description":"Self-hosted Remotion renderer for DYNOSHI daily anime Shorts (1080x1920).","name":"dynoshi-render-service","private":true,"scripts":{"render":"remotion render src/index.ts AnimeShort out/short.mp4","render:pilot":"remotion render src/index.ts AnimeShort out/pilot-short.mp4 --props=./pilot-props.json --concurrency=2","studio":"remotion studio src/index.ts","voiceover":".venv/bin/python scripts/make-voiceover.py"},"version":"1.0.0","dependencies":{"@remotion/cli":"^4.0.542","@remotion/media-utils":"^4.0.542","react":"^19.3.1","react-dom":"^19.3.1","remotion":"^4.0.542"},"devDependencies":{"@types/react":"^19.3.0","@types/react-dom":"^19.3.0","typescript":"^7.0.2"}}